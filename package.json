{
  "name": "blueprint",
  "version": "2.0.0",
  "private": true,
  "description": "Plan personal goals as interactive blueprints and complete learning nodes with the integrated YouTube study panel.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:extension": "node scripts/build-extension.mjs",
    "test": "node --test tests/*.test.js",
    "test:host": "npm run test --workspace @blueprint/native-agent-host",
    "build:host": "npm run build --workspace @blueprint/native-agent-host",
    "smoke:host": "node scripts/smoke-native-host.mjs",
    "package:host": "npm run package --workspace @blueprint/native-agent-host",
    "check": "node scripts/run-bash.mjs scripts/check-release.sh",
    "package": "node scripts/run-bash.mjs scripts/package-extension.sh",
    "package:all": "npm run build:extension && npm run package && npm run package:host"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.185.1"
  }
}
