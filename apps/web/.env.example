NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key
NEXT_PUBLIC_EXTENSION_OAUTH_CLIENT_ID=replace-after-registering-the-public-oauth-client
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Local private Shayna companion. Run npm run setup:companion -- <Shayna_VRM directory>.
# All provider keys and the 64-hex gateway secret remain server-only.
BLUEPRINT_COMPANION_ENABLED=false
# Explicit development-only local PostgreSQL persistence; leave cloud for hosted Auth.
BLUEPRINT_COMPANION_STORAGE=cloud
# Optional absolute directory; defaults to repo/.local/companion.
BLUEPRINT_LOCAL_DATA_DIR=
# Opt-in for account-free private asset review. Bind Next to 127.0.0.1 when enabled.
COMPANION_LOCAL_PREVIEW=false
SHAYNA_ASSET_DIR=
# Optional; defaults to the bundled, licensed idle_loop.vrma directory.
SHAYNA_MOTION_DIR=
VOLC_SPEECH_API_KEY=
COMPANION_GATEWAY_SECRET=
COMPANION_WEB_ORIGIN=http://127.0.0.1:3000
COMPANION_GATEWAY_URL=ws://127.0.0.1:3191
COMPANION_GATEWAY_PORT=3191

# Rolling conversation summaries reuse DeepSeek and can add model usage once
# enough history accumulates. Set false to disable new background summaries.
BLUEPRINT_COMPANION_MEMORY_ENABLED=true

# Server only. Leave disabled until model usage and per-account attempts are approved.
BLUEPRINT_PLANNING_ENABLED=false
DEEPSEEK_API_KEY=
# Independent random secret shared only with the planning-worker Edge function.
# Never put a Supabase service-role or secret API key in the Web environment.
BLUEPRINT_PLANNING_WORKER_SECRET=

# Separate opt-in and allowance for goal clarification; does not inherit planning activation.
BLUEPRINT_CLARIFICATION_ENABLED=false
BLUEPRINT_CLARIFICATION_WORKER_SECRET=

# Separate resource opt-in. Account discovery/caption/matching allowances default to zero.
BLUEPRINT_RESOURCES_ENABLED=false
BLUEPRINT_RESOURCE_ADOPTION_ENABLED=false
BLUEPRINT_RESOURCE_WORKER_SECRET=
YOUTUBE_API_KEY=
SUPADATA_API_KEY=

# Separate explanation opt-in; private per-account allowance defaults to zero.
# Public Web/extension explanation entry is not connected yet.
BLUEPRINT_EXPLANATION_ENABLED=false
BLUEPRINT_EXPLANATION_WORKER_SECRET=
